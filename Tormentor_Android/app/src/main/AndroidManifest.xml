<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent></queries>
    <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Tormentor" android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true" android:icon="@mipmap/ic_tormentor">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".PortalActivity" android:exported="false" />
    </application>
</manifest>

